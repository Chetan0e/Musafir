# =============================================================
# MUSAFIR - Environment Variables
# =============================================================
# Copy this file to .env and fill in your actual values.
# For Vercel: add all variables in Project → Settings → Environment Variables
# =============================================================

# ─── SERVER ──────────────────────────────────────────────────
# Vercel sets PORT automatically — do NOT set it manually on Vercel
PORT=5000

# Set to "production" on Vercel
NODE_ENV=development

# ─── DATABASE ────────────────────────────────────────────────
# MongoDB Atlas connection string (required)
# Get from: https://cloud.mongodb.com → Your Cluster → Connect → Drivers
# Tip: whitelist 0.0.0.0/0 in Network Access for Vercel's dynamic IPs
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── JWT ─────────────────────────────────────────────────────
# Use a strong random string in production (min 32 chars)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ─── AI SERVICES ─────────────────────────────────────────────
# Required for trip generation and place scanning
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ─── IMAGES ──────────────────────────────────────────────────
# Required for destination cover photos
# Get from: https://unsplash.com/developers → New Application
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# ─── CORS ────────────────────────────────────────────────────
# Set to your Vercel frontend URL in production
# e.g. https://musafir.vercel.app
CLIENT_URL=http://localhost:5173

# ─── CLIENT-SIDE (Vite) ──────────────────────────────────────
# IMPORTANT: Vite only exposes variables prefixed with VITE_
# On Vercel: set these in the client's Environment Variables too

# Set to your Vercel backend URL in production
# e.g. https://musafir-api.vercel.app/api  OR  https://musafir.vercel.app/api
VITE_API_URL=http://localhost:5000/api

# Same key as UNSPLASH_ACCESS_KEY above (client needs it for direct searches)
VITE_UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
