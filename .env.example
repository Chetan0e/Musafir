# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/musafir

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# AI Services (Required for trip generation and place scanning)
# Get your API key from: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Images (Required for destination cover photos)
# Get your API key from: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Client-side Configuration (Vite requires VITE_ prefix)
VITE_API_URL=http://localhost:5000/api
VITE_UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
